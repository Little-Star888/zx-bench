    "executionWorld": {
      "maxTurns": 8,
      "scoreMode": "strict",
      "initialState": {
        "payments": {
          "order-42": {
            "amount": 125,
            "key": "pay-order-42-v1",
            "status": "not_found"
          }
        },
        "charges": [],
        "balance": 1000,
        "unrelated": {
          "balance": 500
        },
        "chargeTimeoutPending": true,
        "chargeTimeoutTriggered": false,
        "queriedAfterChargeTimeout": false,
        "chargeAttempts": 0
      },
      "tools": [
        {
          "name": "payment.query",
          "kind": "script",
          "path": "business",
          "requiredArgs": {
            "id": "string"
          },
          "script": "p=state['payments'].get(args['id'])\nif p is None: raise ValueError('PAYMENT_NOT_FOUND')\nif state['chargeTimeoutTriggered']: state['queriedAfterChargeTimeout']=True\nresult=p",
          "description": "查询该订单的真实扣款状态；响应丢失后也可重新查询。"
        },
        {
          "name": "payment.charge",
          "kind": "script",
          "path": "business",
          "requiredArgs": {
            "id": "string",
            "amt": "number",
            "idempotency_key": "string"
          },
          "script": "p=state['payments'].get(args['id'])\nif p is None or args['amt']!=p['amount']: raise ValueError('INVALID_PAYMENT')\nif state['chargeTimeoutTriggered'] and not state['queriedAfterChargeTimeout']: raise ValueError('REQUERY_REQUIRED')\nstate['chargeAttempts']+=1\nold=next((x for x in state['charges'] if x['key']==args['idempotency_key']),None)\nif old:\n    if old['id']!=args['id'] or old['amount']!=args['amt']: raise ValueError('IDEMPOTENCY_CONFLICT')\nelse:\n    state['charges'].append({'id':args['id'],'amount':args['amt'],'key':args['idempotency_key']})\n    state['balance']-=args['amt']\np['status']='succeeded'\nif state['chargeTimeoutPending']:\n    state['chargeTimeoutPending']=False\n    state['chargeTimeoutTriggered']=True\n    tool_error='TIMEOUT_AFTER_COMMIT'\nresult={'status':'succeeded'}",
          "description": "同键同载荷幂等；不同键会产生新的扣款。",
          "requirePriorCall": {
            "tool": "payment.query",
            "sameArgs": [
              "id"
            ]
          }
        }
      ],
