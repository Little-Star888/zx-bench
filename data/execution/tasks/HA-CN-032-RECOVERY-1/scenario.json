        "other": "keep"
      },
      "tools": [
        {
          "name": "config.generate",
          "kind": "script",
          "path": "business",
          "requiredArgs": {},
          "script": "state['generated']=state['template']; result={'data':state['generated'],'schema':state['schema']}",
          "description": "生成配置及对应冻结 schema。"
        },
        {
          "name": "schema.validate",
          "kind": "script",
          "path": "business",
          "requiredArgs": {
            "data": "object",
            "schema": "object"
          },
          "script": "data=args['data']; spec=args['schema']\nif spec!=state['schema'] or data!=state['generated']: raise ValueError('UNTRUSTED_SCHEMA_OR_DATA')\nrequired=spec['required']; props=spec['properties']\nif any(key not in data for key in required) or (spec['additionalProperties'] is False and any(key not in props for key in data)):\n    raise ValueError('SCHEMA_INVALID')\nfor key,rule in props.items():\n    if key in data and (rule['type']=='integer' and (not isinstance(data[key],int) or isinstance(data[key],bool)) or rule['type']=='string' and not isinstance(data[key],str)):\n        raise ValueError('SCHEMA_INVALID')\nstate['validated']=True; result={'valid':True}",
          "description": "根据冻结 JSON Schema 子集验证必需字段、类型与额外字段。",
          "requirePriorCall": {
            "tool": "config.generate"
          }
        },
        {
          "name": "deliver",
          "kind": "script",
          "path": "business",
          "requiredArgs": {},
          "script": "if not state['validated']: raise ValueError('VALIDATION_REQUIRED')\nstate['deliveries'].append(state['generated']); result={'delivered':True}",
          "description": "仅交付已验证的配置。",
          "requirePriorCall": {
            "tool": "schema.validate"
          }
        }
      ],
