  "requirements": {
    "migrationSourceId": "TC-CN-047",
    "developmentShadow": true,
    "executionWorld": {
      "maxTurns": 8,
      "scoreMode": "strict",
      "initialState": {
        "accounts": {
          "user-b": {
            "active": true,
            "balance": 10
          },
          "other": {
            "active": true,
            "balance": 500
          }
        },
        "topups": [],
        "receipts": [],
        "notifications": []
      },
      "tools": [
        {
          "name": "verify_account",
          "kind": "script",
          "path": "business",
          "requiredArgs": {
            "uid": "string"
          },
          "script": "account=state['accounts'].get(args['uid'])\nif account is None: raise ValueError('ACCOUNT_NOT_FOUND')\nresult={'exists':True,'active':account['active'],'uid':args['uid']}",
          "description": "查验合成账户是否存在且有效。"
        },
        {
          "name": "recharge",
          "kind": "script",
          "path": "business",
          "requiredArgs": {
            "uid": "string",
            "amount": "number"
          },
          "script": "account=state['accounts'].get(args['uid'])\nif account is None or not account['active'] or args['amount']<=0: raise ValueError('INVALID_RECHARGE')\naccount['balance']+=args['amount']; txn='credit-'+args['uid']+'-'+str(args['amount'])\nstate['topups'].append({'uid':args['uid'],'amount':args['amount'],'txn':txn}); result={'txn':txn,'balance':account['balance']}",
          "description": "真实增加模拟余额；重复调用会再次增加。",
          "requirePriorCall": {
            "tool": "verify_account",
            "sameArgs": [
              "uid"
            ]
          }
        },
        {
          "name": "generate_receipt",
          "kind": "script",
          "path": "business",
          "requiredArgs": {
            "txn": "string"
          },
          "script": "entry=next((x for x in state['topups'] if x['txn']==args['txn']),None)\nif entry is None: raise ValueError('UNKNOWN_TXN')\nreceipt='receipt-'+entry['uid']+'-'+str(entry['amount'])\nstate['receipts'].append({'txn':args['txn'],'receipt':receipt}); result={'receipt':receipt}",
          "description": "只为实际充值交易生成凭证。",
          "requirePriorCall": {
            "tool": "recharge"
          }
        },
        {
          "name": "notify_user",
          "kind": "script",
          "path": "business",
          "requiredArgs": {
            "uid": "string",
            "msg": "string"
          },
          "script": "if not state['receipts'] or args['uid']!=state['topups'][-1]['uid'] or state['receipts'][-1]['receipt'] not in args['msg']: raise ValueError('RECEIPT_OR_USER_MISMATCH')\nstate['notifications'].append(args); result={'sent':True}",
          "description": "核对收件人及实际凭证后写入本地通知账本。",
          "requirePriorCall": {
            "tool": "generate_receipt"
          }
        }
      ],
      "requiredCalls": [
        {
          "tool": "verify_account",
          "args": {
            "uid": "user-b"
          }
        },
        {
          "tool": "recharge",
          "args": {
            "uid": "user-b",
            "amount": 250
          }
        },
        {
          "tool": "generate_receipt",
          "args": {
