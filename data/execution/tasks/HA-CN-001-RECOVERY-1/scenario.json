          "script": "if args['key']!='project/database' or args['value']!='本项目已迁移到 CockroachDB': raise ValueError('INVALID_FACT')\nstate['memory'][args['key']]=args['value']; state['history'].append('saved:'+args['key'])\nresult={'saved':args['key']}",
