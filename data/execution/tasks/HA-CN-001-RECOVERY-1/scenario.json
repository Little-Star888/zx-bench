          "script": "if args['key'] not in state['memory']: raise ValueError('NOT_FOUND')\nif state['memory'][args['key']]!='本项目使用 PostgreSQL': raise ValueError('NOT_STALE_FACT')\nstate['history'].append('deleted:'+args['key']); del state['memory'][args['key']]\nresult={'deleted':args['key']}",
          "description": "只删除确认过的旧数据库事实。",
          "requirePriorCall": {
            "tool": "memory.read",
            "sameArgs": [
              "key"
            ]
          }
