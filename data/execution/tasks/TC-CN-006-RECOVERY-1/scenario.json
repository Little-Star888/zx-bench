          "script": "if args['to']!=state['ownerEmail'] or args['body']!=state['docs'][1]['content']: raise ValueError('WRONG_RECIPIENT_OR_SUMMARY')\nstate['emails'].append(args); result={'sent':True}",
          "description": "记录合成邮件发送。",
