    "executionCases": [
      {
        "files": [
          {
            "path": "run.sh",
            "content": "echo \"release-0\"\n"
          },
          {
            "path": "sentinel",
            "content": "keep"
          }
        ],
        "setupCommands": [
          "chmod 755 run.sh"
        ],
        "expectedFiles": {
          "run.sh": "#!/bin/bash\necho \"release-0\"\n",
          "run-output.txt": "release-0\n"
        },
        "unchangedFiles": [
          "sentinel"
        ],
        "assertCommands": [
          "python3 -I - <<'PY'\nimport subprocess\nassert subprocess.check_output(['./run.sh'],text=True)==\"release-0\\n\"\nPY"
        ]
      },
      {
        "files": [
