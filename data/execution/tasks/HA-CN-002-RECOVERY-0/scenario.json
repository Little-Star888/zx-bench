          "kind": "script",
          "path": "business",
          "requiredArgs": {
            "key": "string"
          },
          "script": "key=args['key']\nif key not in state['memory']: raise ValueError('NOT_FOUND')\nvalue=state['memory'].pop(key); state['used']-=len(value)\nstate['history'].append('delete:'+key); result={'deleted':key}",
          "description": "删除确认为冗余的记忆条目。",
          "requirePriorCall": {
            "tool": "memory.read",
            "sameArgs": [
              "key"
            ]
