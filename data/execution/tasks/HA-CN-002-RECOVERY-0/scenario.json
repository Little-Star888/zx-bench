        {
          "name": "memory.save",
          "kind": "script",
          "path": "business",
          "requiredArgs": {
            "key": "string",
            "value": "string"
          },
          "script": "key=args['key']; value=args['value']\nnext_used=state['used']-len(state['memory'].get(key,''))+len(value)\nif next_used>state['capacity']: raise ValueError('MEMORY_CAPACITY_EXCEEDED')\nstate['memory'][key]=value; state['used']=next_used\nstate['history'].append('save:'+key); result={'used':next_used}",
          "description": "容量检查后才持久化；超限不写入。",
          "requirePriorCall": {
            "tool": "memory.list"
          }
        }
