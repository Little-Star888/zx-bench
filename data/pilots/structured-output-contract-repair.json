    "locale": "zh-CN",
    "status": "valid",
    "tier": "public_dev",
    "promptTemplate": "请为一个\"员工信息管理系统\"生成 JSON Schema（draft-07）。\n\n要求：\n1. 定义 Employee 对象，包含：id, name, department, position, salary, hire_date, skills, address\n2. skills 是字符串数组，至少1项\n3. address 是嵌套对象（province, city, district, street, zipcode）\n4. salary 是数字，最小值3000，最大值200000\n5. hire_date 格式为 date\n6. department 枚举值：技术部、产品部、市场部、人事部、财务部\n7. 必填字段：id, name, department, hire_date\n8. 包含 $schema, title, description 顶级字段\n9. 输出纯 JSON",
    "sourceCode": null,
    "functionName": null,
    "expectedVerdict": null,
    "grader": "schema_compliance",
    "graderVersion": "schema_compliance_v6",
    "scoring": {
      "type": "schema_compliance"
    },
    "requirements": {
      "format": "json",
      "output_policy": "raw_only",
      "requiredFields": [
        "$schema",
        "title",
        "description",
        "type",
        "properties",
        "required"
      ],
      "axis_weights": {
        "syntax_parse": 0.15,
        "schema_compliance": 0.2,
        "field_constraints": 0.45,
        "cross_field_consistency": 0.05,
        "output_discipline": 0.15
      },
      "constraints": [
        "valueEq:properties.salary.minimum=3000",
        "valueEq:properties.salary.maximum=200000",
        "valueEq:properties.skills.minItems=1",
        "valueEq:properties.hire_date.format=date",
        "jsonSetEq:properties.department.enum=[\"技术部\",\"产品部\",\"市场部\",\"人事部\",\"财务部\"]",
        "arrayContainsAll:required=[\"id\",\"name\",\"department\",\"hire_date\"]"
      ]
    },
