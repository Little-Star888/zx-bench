    "id": "SO-CN-031",
    "category": "json",
    "difficulty": "hard",
    "language": "json",
    "promptTemplate": "请为一个「多租户工单系统」生成 JSON Schema（draft-07）。\n\n要求：\n1. 顶级包含 $schema、$id、title、description、type、properties、required、$defs\n2. 定义 Ticket 对象：id（string, format 为 uuid）、tenantId、title、priority（枚举：low/medium/high/critical）、status（枚举：open/closed/pending）、assignee（引用 $defs 中的 User）、tags（字符串数组，minItems 1）、createdAt（string, format 为 date-time）\n3. 用 $defs 定义可复用的 User 对象（id、name、email）\n4. 用 oneOf 表达「assignee 是 User 对象 或 是 null」\n5. 用 pattern 约束 ticketNumber，例如以 TKT- 开头后跟数字\n6. required 至少包含 id、tenantId、title、priority、status、createdAt\n7. 输出纯 JSON，不要 markdown 代码块\n根 Schema 自身定义 Ticket 对象；$defs.User 仅供 assignee 引用。",
    "requirements": {
      "format": "json",
      "output_policy": "raw_only",
      "requiredFields": [
        "$schema",
        "$id",
        "title",
        "description",
        "type",
        "properties",
        "required",
        "$defs",
        "properties.priority",
        "properties.tags",
        "properties.createdAt",
        "properties.ticketNumber",
        "**.oneOf",
        "**.pattern",
        "**.minItems"
      ],
      "schema": {
        "type": "object",
        "required": [
          "$schema",
          "type",
          "properties",
          "$defs"
        ],
        "properties": {
          "properties": {
            "type": "object"
          },
          "$defs": {
            "type": "object"
          },
          "required": {
            "type": "array",
            "minItems": 4
          }
        }
      },
      "axis_weights": {
        "syntax_parse": 0.15,
        "schema_compliance": 0.2,
        "field_constraints": 0.45,
        "cross_field_consistency": 0.05,
        "output_discipline": 0.15
      },
      "constraints": [
        "schemaAccepts:.={\"id\":\"123e4567-e89b-12d3-a456-426614174000\",\"tenantId\":\"tenant-1\",\"title\":\"工单\",\"priority\":\"low\",\"status\":\"open\",\"assignee\":null,\"tags\":[\"help\"],\"createdAt\":\"2024-03-20T12:00:00Z\",\"ticketNumber\":\"TKT-100\"}",
        "schemaRejectsLiteral:.={\"id\":\"123e4567-e89b-12d3-a456-426614174000\",\"tenantId\":\"tenant-1\",\"title\":\"工单\",\"priority\":\"urgent\",\"status\":\"open\",\"assignee\":null,\"tags\":[\"help\"],\"createdAt\":\"2024-03-20T12:00:00Z\",\"ticketNumber\":\"TKT-100\"}",
        "schemaRejectsLiteral:.={\"id\":\"123e4567-e89b-12d3-a456-426614174000\",\"tenantId\":\"tenant-1\",\"title\":\"工单\",\"priority\":\"low\",\"status\":\"open\",\"assignee\":null,\"tags\":[],\"createdAt\":\"2024-03-20T12:00:00Z\",\"ticketNumber\":\"TKT-100\"}",
        "schemaRejectsLiteral:.={\"id\":\"123e4567-e89b-12d3-a456-426614174000\",\"tenantId\":\"tenant-1\",\"title\":\"工单\",\"priority\":\"low\",\"status\":\"open\",\"assignee\":null,\"tags\":[\"help\"],\"createdAt\":\"2024-03-20T12:00:00Z\",\"ticketNumber\":\"BAD-100\"}",
        "schemaRejectsLiteral:.={\"id\":\"123e4567-e89b-12d3-a456-426614174000\",\"tenantId\":\"tenant-1\",\"title\":\"工单\",\"priority\":\"low\",\"status\":\"open\",\"assignee\":42,\"tags\":[\"help\"],\"createdAt\":\"2024-03-20T12:00:00Z\",\"ticketNumber\":\"TKT-100\"}"
      ]
    },
