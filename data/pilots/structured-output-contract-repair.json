  {
    "id": "SO-CN-005",
    "dimension": "structured_output",
    "category": "json",
    "difficulty": "hard",
    "language": "json",
    "locale": "zh-CN",
    "status": "valid",
    "tier": "public_dev",
    "promptTemplate": "请生成一个包含以下内容的 JSON 对象：\n\n1. name: 包含引号的字符串，如：他说\"你好\"\n2. path: Windows 路径，如：C:\\Users\\admin\\file.txt\n3. description: 包含换行符的多行文本\n4. emoji: 包含 emoji 表情，如：🎉🚀💡\n5. chinese: 包含中文特殊标点，如：《》【】「」\n6. url: 包含查询参数的 URL\n7. code: 包含代码片段，有反斜杠和反引号\n8. null_value: null\n9. empty_string: 空字符串\n\n输出纯 JSON，确保所有特殊字符正确转义。",
    "sourceCode": null,
    "functionName": null,
    "expectedVerdict": null,
    "grader": "schema_compliance",
    "graderVersion": "schema_compliance_v6",
    "scoring": {
      "type": "schema_compliance"
    },
    "requirements": {
      "format": "json",
      "output_policy": "raw_only",
      "requiredFields": [
        "name",
        "path",
        "description",
        "emoji",
        "chinese",
        "url",
        "code",
        "null_value",
        "empty_string"
      ],
      "axis_weights": {
        "syntax_parse": 0.15,
        "schema_compliance": 0.2,
        "field_constraints": 0.45,
        "cross_field_consistency": 0.05,
        "output_discipline": 0.15
      },
      "constraints": [
        "matches:name:\"",
        "matches:path:^[A-Za-z]:\\\\",
        "matches:description:\\n",
        "matches:emoji:[\\u{1F300}-\\u{1FAFF}]",
        "matches:chinese:[《》【】「」]",
        "matches:url:\\?",
        "matches:code:\\\\",
        "matches:code:`",
        "type:null_value=null",
        "valueEq:empty_string=\"\""
      ]
    },
    "tags": [
      "chinese",
      "json",
      "special-characters",
      "adversarial",
      "escaping"
    ],
