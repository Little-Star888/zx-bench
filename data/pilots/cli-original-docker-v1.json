              "content": "old"
            },
            {
              "path": "in/new.txt",
              "content": "new"
            },
            {
              "path": "in/sub/very-old.txt",
              "content": "nested"
            }
          ],
          "setupCommands": [
            "python3 - <<'PY'\nimport os\nfrom datetime import datetime, timezone\nfor path, iso in [[\"in/old.txt\",\"2025-11-01T00:00:00Z\"],[\"in/new.txt\",\"2025-12-15T00:00:00Z\"],[\"in/sub/very-old.txt\",\"2025-10-01T00:00:00Z\"]]:\n    timestamp = datetime.fromisoformat(iso.replace('Z', '+00:00')).timestamp()\n    os.utime(path, (timestamp, timestamp))\nPY"
          ],
          "expectedFiles": {
            "archive/old.txt": "old"
          },
          "absentFiles": [
            "in/old.txt"
          ],
          "unchangedFiles": [
            ".now",
