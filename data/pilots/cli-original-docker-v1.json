    "requirements": {
      "executionImage": "python:3.12-alpine",
      "executionImageId": "sha256:d09d15e60962ca365d1cd544a48773bac9d33f2fb1b00f2aa0deec78ade7dc31",
      "executionInterpreter": "sh",
      "executionCases": [
        {
          "files": [
            {
              "path": ".now",
              "content": "2026-01-01T00:00:00Z\n"
            },
            {
