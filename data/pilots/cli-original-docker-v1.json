          ],
          "expectedFiles": {
            "archive/stale.txt": "stale"
          },
          "absentFiles": [
            "in/stale.txt"
          ],
          "unchangedFiles": [
            ".now",
            "in/fresh.txt"
          ],
          "assertCommands": [
            "python3 -c \"import os; assert int(os.stat('archive/stale.txt').st_mtime) == 1767225600\""
