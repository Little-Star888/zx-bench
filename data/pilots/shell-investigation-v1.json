            "content": "import sys\n\n# 按传入顺序合并配置，后加载的覆盖先加载的\nmerged = {}\nargs = sys.argv[1:]\ni = 0\nwhile i < len(args):\n    if args[i] == \"-c\":\n        # 简化：直接读取 yaml 中的 host\n        with open(args[i + 1]) as f:\n            for line in f:\n                if \"host:\" in line:\n                    merged[\"host\"] = line.split(\":\", 1)[1].strip()\n        i += 2\n    else:\n        i += 1\nprint(\"db host: \" + merged[\"host\"])\n"
